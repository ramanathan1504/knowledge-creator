#
# kb — one entry point over the archive, so OSS-CLI has something to call.
#
#   ./kb file <file.md> [...]   file a written review or note into the archive
#   ./kb index                  re-read changed files into DEVONthink
#   ./kb harvest                incremental harvest from every source
#   ./kb map                    rebuild the topic map
#   ./kb digest                 rebuild the per-topic digests
#   ./kb coverage [next|show|done|refresh]   what is left to learn, and what is done
#   ./kb token                  store a GitHub token for the scheduled job (input hidden)
#   ./kb doctor                 is the archive reachable, and when did it last sync
#
# This repo grew as a set of scripts, each doing one job well, which is the right
# shape for a person who knows them. It is the wrong shape for another program:
# an extension declares ONE executable, and "call whichever of fourteen scripts
# applies" is not a contract anything can hold. So this dispatches, and adds
# nothing of its own beyond that.
#
# Registered with: oss-cli ext add <this directory>

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() { printf '\033[31merror\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  # Anchored to the licence block rather than to line numbers: the header pushed
  # the doc comment down and a fixed range printed the licence as help text.
  sed -n '/limitations under the License\./,$p' "${BASH_SOURCE[0]}" \
    | sed -n '2,/^[^#]/p' | sed 's/^# \{0,1\}//' | sed '/^$/d;$d'
}

[[ $# -gt 0 ]] || { usage; exit 0; }

verb=$1; shift

case "$verb" in
  file)
    [[ $# -gt 0 ]] || die "file needs at least one markdown file"
    # --apply is deliberate here. Every script in this repo dry-runs by default,
    # which is right at a prompt and wrong from a program: OSS-CLI calling `file`
    # means "file it", and a silent dry run would report success having written
    # nothing -- the exact failure this archive exists to prevent.
    exec "$ROOT/pr-review-file.py" "$@" --apply
    ;;
  index)
    exec "$ROOT/devon-index.sh" --sync "$@"
    ;;
  harvest)
    exec "$ROOT/oss-harvest.py" "$@"
    ;;
  map)
    exec "$ROOT/knowledge-map.py" "$@"
    ;;
  digest)
    exec "$ROOT/topic-digest.py" "$@"
    ;;
  coverage)
    # Read-only verbs stay read-only; the two that change something get --apply
    # added for them, for the same reason `file` does. A program calling
    # `coverage done <x>` means it, and a silent dry run would report success
    # having moved nothing.
    sub=${1:-list}
    case "$sub" in
      done|refresh)
        exec "$ROOT/coverage-queue.py" "$@" --apply ;;
      *)
        exec "$ROOT/coverage-queue.py" "$@" ;;
    esac
    ;;
  token)
    # Exists because "put a secret in a file at this path with these permissions"
    # is three chances to get it wrong, and the failure modes are quiet: a mode
    # 644 file is refused, a trailing newline can break the token, and a shell
    # that records history keeps the secret forever.
    #
    # read -s so it is never echoed, never in argv (visible to `ps`), and never
    # in shell history.
    TOKEN_FILE="${KB_GH_TOKEN_FILE:-$HOME/.config/knowledge-creator/gh-token}"
    if [ -f "$TOKEN_FILE" ]; then
      printf 'A token file already exists at %s\n' "$TOKEN_FILE"
      printf 'Replace it? [y/N] '
      read -r reply
      case "$reply" in y|Y|yes|YES) ;; *) echo "unchanged"; exit 0 ;; esac
    fi
    printf 'Paste a GitHub token (input hidden, then press Enter): '
    read -rs TOKEN; echo
    TOKEN=$(printf '%s' "$TOKEN" | tr -d ' \t\r\n')
    [ -n "$TOKEN" ] || die "nothing entered; unchanged"
    mkdir -p "$(dirname "$TOKEN_FILE")"
    # Create empty and lock it down BEFORE writing: a file that is briefly
    # world-readable while holding a secret is world-readable at the only moment
    # that matters.
    : > "$TOKEN_FILE"
    chmod 600 "$TOKEN_FILE"
    printf '%s' "$TOKEN" > "$TOKEN_FILE"
    printf '\033[32m✓\033[0m written to %s (mode 600)\n' "$TOKEN_FILE"
    if ! GH_TOKEN="$TOKEN" gh auth status >/dev/null 2>&1; then
      printf '\033[31m!\033[0m GitHub REJECTED it. The file was still written; fix or re-run.\n' >&2
      exit 1
    fi
    who=$(GH_TOKEN="$TOKEN" gh api user --jq .login 2>/dev/null || echo "?")
    printf '\033[32m✓\033[0m GitHub accepts it — authenticated as %s\n' "$who"

    # "The token works" is not the question. The harvester needs two DIFFERENT
    # things, and a token can satisfy one while failing the other silently --
    # which is a stage that quietly returns nothing rather than an error.
    printf '\n  what this token can actually reach:\n'

    # 1. Public search. This is the whole GitHub stage: `involves:<user>` across
    #    repos you do not own. A fine-grained token granted only your own repos
    #    still needs to read these.
    hits=$(GH_TOKEN="$TOKEN" gh api -X GET search/issues \
             -f q="involves:${who} repo:apache/logging-log4j2" --jq '.total_count' 2>/dev/null || echo "")
    if [ -n "$hits" ] && [ "$hits" != "null" ]; then
      printf '    \033[32m✓\033[0m public search — %s results in apache/logging-log4j2\n' "$hits"
    else
      printf '    \033[31m✗\033[0m public search FAILED — the GitHub stage would harvest nothing\n'
    fi

    # 2. This private repo, only if you want your own private work harvested.
    if GH_TOKEN="$TOKEN" gh api repos/"${who}"/knowledge-creator --jq .name >/dev/null 2>&1; then
      printf '    \033[32m✓\033[0m private repo knowledge-creator — readable\n'
    else
      printf '    \033[2m·\033[0m private repo knowledge-creator — not readable (fine if you do not harvest it)\n'
    fi
    printf '\n  The 09:15 job no longer depends on the keychain.\n'
    ;;
  doctor)
    # Deliberately not a wrapper around another script: the question "is the
    # daily job actually succeeding" had no answer anywhere, and its absence let
    # a scheduled harvest fail for days in a log nobody reads.
    printf 'archive : %s\n' "$(python3 -c 'import kbpaths; print(kbpaths.ARCHIVE)' 2>/dev/null || echo '(kbpaths not importable)')"
    if [[ -f $ROOT/logs/oss-harvest.err.log ]]; then
      last_fail=$(grep -c "STAGES FAILED" "$ROOT/logs/oss-harvest.err.log" 2>/dev/null || echo 0)
      printf 'harvest : last log has %s failed-stage line(s)\n' "$last_fail"
      printf '          %s\n' "$(tail -1 "$ROOT/logs/oss-harvest.err.log" 2>/dev/null)"
    else
      printf 'harvest : no log yet\n'
    fi
    # NOT `launchctl list | grep -q`. Under `set -o pipefail` that reports the
    # agent as missing precisely WHEN it matches: grep -q exits on the first hit
    # and closes the pipe, launchctl dies of SIGPIPE, and pipefail returns the
    # failure. Capture first, match second.
    agents=$(launchctl list 2>/dev/null || true)
    case "$agents" in
      *oss-harvest*) printf 'schedule: launchd agent loaded\n' ;;
      *) printf 'schedule: \033[33mnot loaded\033[0m — ./oss-harvest-daily.sh --install\n' ;;
    esac
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    die "unknown verb: $verb (try: file index harvest map digest coverage token doctor)"
    ;;
esac